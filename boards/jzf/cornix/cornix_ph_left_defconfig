# e73 config

CONFIG_ADC_NRFX_SAADC=y

# Enable MPU
CONFIG_ARM_MPU=y

CONFIG_PINCTRL=y

# enable GPIO
CONFIG_GPIO=y

CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y
CONFIG_CLOCK_CONTROL_NRF=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y

# --- 省電力 ---
# nRF52840 内蔵 DC/DC(降圧)レギュレータを有効化。既定の LDO より効率が高く、
# 特に無線送信時の電流を削減できる(E73 モジュールに DC/DC 用インダクタ実装が前提)。
CONFIG_BOARD_ENABLE_DCDC=y
# アイドル継続でディープスリープ(system-OFF, 数µA)へ移行。kscan0 を起床ソースとして
# キー入力で復帰する(cornix.dtsi の wakeup-sources / wakeup-source 参照)。
CONFIG_ZMK_SLEEP=y
# 15分(=900000ms)無操作でディープスリープへ。
CONFIG_ZMK_IDLE_SLEEP_TIMEOUT=900000

# e73 config end

CONFIG_ZMK_SPLIT=y


CONFIG_ZMK_STUDIO=n


# RGB
CONFIG_SPI=n

CONFIG_EC11=y
CONFIG_EC11_TRIGGER_GLOBAL_THREAD=y

# vim: set ft=kconfig: